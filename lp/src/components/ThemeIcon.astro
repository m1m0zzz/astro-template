---
import { Moon, Sun } from "@lucide/astro"

/**
 * テーマ切り替えボタン。初期テーマの適用は `ThemeScript.astro` が
 * `<head>` で行うので、ここではトグルだけを担当する。
 */

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<button
  id="themeToggle"
  class={`cursor-pointer border-0 bg-none hover:opacity-80 ${className || ""}`}
  aria-label="テーマを切り替える"
>
  <Sun aria-hidden="true" class="w-7.5 dark:hidden" />
  <Moon aria-hidden="true" class="hidden w-7.5 dark:block" />
</button>

<script is:inline>
  document.getElementById("themeToggle")?.addEventListener("click", () => {
    const element = document.documentElement
    const isDark = element.getAttribute("data-theme") === "dark"

    if (isDark) {
      element.removeAttribute("data-theme")
    } else {
      element.setAttribute("data-theme", "dark")
    }

    localStorage.setItem("theme", isDark ? "light" : "dark")
  })
</script>

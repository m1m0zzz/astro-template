---
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <div
    class="text-foreground bg-background grid min-h-full grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto]"
  >
    <main class="mx-auto w-full max-w-5xl p-4">
      <section class="flex flex-col gap-4">
        <h1 class="mt-4 text-4xl">mimoz's Astro Starter Kit: LP</h1>
        <div class="overflow-auto bg-neutral-200 p-4 font-mono">
          <pre>npm create astro@latest -- --template m1m0zzz/astro-template/lp</pre>
        </div>
        <h2 class="text-2xl">✨ Features</h2>
        <ul class="list-inside list-disc pl-2">
          <li>Tailwind CSS</li>
          <li>astro/sitemap</li>
          <li>OGP template</li>
          <li>ESLint + Prettier</li>
          <li>husky + lint-staged</li>
          <li>VSCode config</li>
        </ul>
        <p>
          more information: <a
            class="text-blue-600 underline hover:text-blue-400"
            href="https://github.com/m1m0zzz/astro-template"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </p>
      </section>
    </main>
    <footer class="flex h-30 items-center justify-center bg-neutral-200">
      &copy; {new Date().getFullYear()} mimoz
    </footer>
  </div>
</Layout>

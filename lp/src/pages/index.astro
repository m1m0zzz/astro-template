---
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <div
    class="text-foreground bg-background grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto] min-h-full"
  >
    <main class="w-full max-w-5xl mx-auto p-4">
      <section class="flex flex-col gap-4">
        <h1 class="text-4xl mt-4">mimoz's Astro Starter Kit: LP</h1>
        <div class="p-4 bg-neutral-200 font-mono overflow-auto">
          <pre>npm create astro@latest -- --template m1m0zzz/astro-template/lp</pre>
        </div>
        <h2 class="text-2xl">✨ Features</h2>
        <ul class="list-inside list-disc pl-2">
          <li>Tailwind CSS</li>
          <li>astro/sitemap</li>
          <li>OGP template</li>
          <li>ESLint + Prettier</li>
          <li>husky + lint-staged</li>
          <li>VSCode config</li>
        </ul>
        <p>
          more information: <a
            class="underline text-blue-600 hover:text-blue-400"
            href="https://github.com/m1m0zzz/astro-template"
            target="_blank"
            rel="noopener noreferrer">GitHub</a>
        </p>
      </section>
    </main>
    <footer class="h-30 bg-neutral-200 flex justify-center items-center">
      &copy; {new Date().getFullYear()} mimoz
    </footer>
  </div>
</Layout>

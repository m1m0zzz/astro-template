{
  "name": "@astro-template/blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "debug:page": "tsx scripts/debug-page.ts",
    "favicon": "tsx scripts/generate-favicon.ts",
    "typecheck": "npm run typecheck:app && npm run typecheck:node",
    "typecheck:app": "astro check --tsconfig tsconfig.app.json",
    "typecheck:node": "tsc -b tsconfig.node.json",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.2",
    "@floating-ui/dom": "^1.8.0",
    "@lucide/astro": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "satori": "^0.33.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tsx": "4.23.13"
  },
  "lint-staged": {
    "**/*.{js,jsx,cjs,mjs,ts,tsx,mts,cts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,html,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  }
}

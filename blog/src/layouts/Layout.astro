---
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"
import ThemeScript from "@/components/ThemeScript.astro"
import { SITE } from "@/config"
import { withBase } from "@/lib/path"

import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  /** OGP 画像の絶対 URL。渡さなければ og:image を出力しない */
  ogImage?: URL | string
  /** 記事ページは "article" にする */
  ogType?: "website" | "article"
}

const {
  title: _title,
  description: _description,
  ogImage,
  ogType = "website",
} = Astro.props

const title = _title ? `${_title} | ${SITE.name}` : SITE.name
const description = _description || SITE.description

// テスト環境などで noindex にしたい場合、NO_INDEX=1 を渡す
const noIndex = import.meta.env.NO_INDEX === "1"

// 現在のページの絶対 URL。`Astro.url.pathname` は base を含む
const ogUrl = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeScript />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <!-- <link
      rel="apple-touch-icon"
      href={withBase("apple-touch-icon.png")}
      sizes="180x180"
    /> -->
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- TODO: Set the ID, or delete the line below if Google Analytics is not required. -->
    <GoogleAnalytics id="G-XXXXXXXXXX" />

    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage.toString()} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterID} />
  </head>
  <body>
    <slot />
  </body>
</html>

---
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"
import { withBase } from "@/lib/path"

import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const { title: _title, description: _description } = Astro.props

const siteName = "SITE NAME" // TODO
const title = _title ? `${_title} | ${siteName}` : siteName
const description = _description || "SITE DESCRIPTION" // TODO
const twitterID = "@xxxxxx" // TODO

// テスト環境などで noindex にしたい場合、NO_INDEX=1 を渡す
const noIndex = import.meta.env.NO_INDEX === "1"

// 現在のページの絶対 URL。`Astro.url.pathname` は base を含む
const ogUrl = new URL(Astro.url.pathname, Astro.site)

// TODO: OGP.png をpublicフォルダに配置
// public/OGP.png（1200×630）
// const ogImage = {
//   url: new URL(withBase("OGP.png"), Astro.site),
//   width: "1200",
//   height: "630",
// }
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <!-- <link
      rel="apple-touch-icon"
      href={withBase("apple-touch-icon.png")}
      sizes="180x180"
    /> -->
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- TODO: Set the ID, or delete the line below if Google Analytics is not required. -->
    <GoogleAnalytics id="G-XXXXXXXXXX" />

    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <!-- TODO: OGP.png をpublicフォルダに配置 -->
    <!-- <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={ogImage.width} />
    <meta property="og:image:height" content={ogImage.height} /> -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterID} />
  </head>
  <body>
    <slot />
  </body>
</html>

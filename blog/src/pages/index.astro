---
import { ExternalLink } from "@lucide/astro"

import astroLogo from "../assets/astro.svg"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <div
    class="text-foreground bg-background grid min-h-full grid-rows-[auto_1fr_auto]"
  >
    <nav class="flex h-15 items-center justify-between bg-neutral-200 px-4">
      <div>
        <a href="/"
          ><img
            src={astroLogo.src}
            width="115"
            height="48"
            alt="Astro Homepage"
          /></a
        >
      </div>
      <a
        href="https://github.com/"
        target="_blank"
        class="flex items-center justify-center gap-1"
      >
        <span> GitHub </span>
        <ExternalLink class="inline-block size-4" />
      </a>
    </nav>
    <main class="mx-auto w-full max-w-5xl p-4">
      <section id="hero">
        <h1>
          To get started, open the <code><pre>src/pages</pre></code> directory in
          your project.
        </h1>
      </section>
    </main>
    <footer
      class="flex h-30 items-center justify-center bg-neutral-800 text-white"
    >
      &copy; {new Date().getFullYear()} mimoz
    </footer>
  </div>
</Layout>

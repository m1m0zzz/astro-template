{
  "name": "@astro-template/blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@lucide/astro": "^1.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,cjs,mjs,ts,tsx,mts,cts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,html,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "vite": "^8.0.0"
  }
}

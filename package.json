{
  "name": "astro-template-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Builder for the Astro templates. Edit files under builder/, then run npm run sync.",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.0"
  },
  "workspaces": [
    "blog",
    "lp"
  ],
  "scripts": {
    "sync": "node scripts/sync-templates.mjs",
    "sync:strict": "node scripts/sync-templates.mjs && npm run check && node scripts/sync-templates.mjs --reverse",
    "sync:watch": "node scripts/sync-templates.mjs --watch",
    "sync:reverse": "node scripts/sync-templates.mjs --reverse",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "node scripts/build-pages.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "marked": "18.0.9"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
